APP_ENV=local
APP_DEBUG=false

DB_DRIVER=sqlite
# Caminho do arquivo SQLite (relativo à raiz do projeto)
DB_DATABASE=data/cdt.sqlite

# MySQL (produção opcional)
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=db_cartao
# DB_USERNAME=root
# DB_PASSWORD=

# Gere com: php -r "echo password_hash('sua-senha', PASSWORD_DEFAULT), PHP_EOL;"
ADMIN_PASSWORD_HASH=

# Origens permitidas (vírgula). Vazio = mesma origem apenas.
CORS_ALLOWED_ORIGINS=

# Cookies de sessão HTTPS (true em produção com TLS)
SESSION_SECURE=false

# Gateway: mock (padrão) ou stripe (requer cURL e STRIPE_SECRET_KEY)
PAYMENT_GATEWAY=mock
STRIPE_SECRET_KEY=

# Rate limit
RATE_LIMIT_CADASTRO_MAX=20
RATE_LIMIT_CADASTRO_WINDOW=3600

# Painel: itens por página
PAINEL_PAGE_SIZE=15

# LGPD: excluir cadastros mais antigos que N dias (0 = desativado)
# Purga automática no painel (1x/24h) e via: php scripts/lgpd-purge.php
LGPD_RETENTION_DAYS=0